{
  "name": "stripe-flows-reference",
  "version": "0.1.0",
  "private": true,
  "description": "The Stripe flows the quickstart does not cover: idempotent charges, webhook-driven state that never trusts the redirect, dunning, proration, refunds, disputes, a double-entry ledger and a reconciliation job that finds drift.",
  "author": "Mohad Jillani <mohad.jillani@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohadjillani/stripe-flows-reference.git"
  },
  "homepage": "https://github.com/mohadjillani/stripe-flows-reference#readme",
  "bugs": "https://github.com/mohadjillani/stripe-flows-reference/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "reconcile": "tsx src/reconcile/job.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.2.0",
    "pg": "^8.23.0",
    "stripe": "^20.1.0",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  }
}
