# The database the ledger and event store live in.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/stripedemo

# Required. The service refuses to start without it, because an endpoint that
# cannot verify signatures must not accept events.
#   stripe listen --forward-to localhost:3000/webhooks/stripe
# prints the value to use here.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. Only the live test suite, the bootstrap script and the
# reconciliation job need it; the service and every other test run without one.
# STRIPE_SECRET_KEY=sk_test_replace_me

PORT=3000
